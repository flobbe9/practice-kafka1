{
    "name": "redpanda",
    "version": "0.0.1",
    "type": "module",
    "main": "index.js",
    "types": "index.d.ts",
    "license": "MIT",
    "scripts": {
        "build": "sh ./build.sh",
        "buildOmitTests": "sh ./build.sh --omitTests",
        "buildClean": "sh ./build.sh --clean",
        "buildOmitTestsClean": "sh ./build.sh --clean --omitTests",
        "test": "jest --watch"
    },
    "dependencies": {
        "buffer": "^6.0.3"
    },
    "devDependencies": {
        "tsc-esm-fix": "^3.1.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.10.4",
        "add-js-extension": "^1.0.4",
        "jest": "^30.2.0",
        "shx": "^0.4.0",
        "ts-jest": "^29.4.6",
        "tsc-alias": "^1.8.16",
        "typescript": "~5.9.3"
    },
    "jest": {
        "preset": "ts-jest",
        "transform": {
            "node_modules/variables/.+\\.(j|t)sx?$": "ts-jest"
        },
        "transformIgnorePatterns": [
            "node_modules/(?!variables/.*)"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    }
}
